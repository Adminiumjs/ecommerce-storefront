{
  "manifestVersion": 1,
  "key": "ecommerce-shop",
  "name": "Ecommerce Storefront",
  "version": "1.0.0",
  "publisher": {
    "id": "adminium",
    "name": "Adminium",
    "url": "https://adminium.dev"
  },
  "license": "AGPL-3.0-only",
  "description": {
    "key": "mft.ecommerce.desc",
    "fallback": "A complete e-commerce storefront with an admin dashboard for catalog, orders, customers, and revenue — backed by your own database."
  },
  "categories": [
    "commerce"
  ],
  "compatibility": {
    "minAdminiumVersion": "1.0.0",
    "engines": [
      "postgres",
      "mysql",
      "sqlite"
    ],
    "requires": [
      "realtime",
      "file-storage"
    ]
  },
  "requiredSchema": {
    "tables": [
      {
        "ref": "products",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "title",
            "type": "text"
          },
          {
            "ref": "sku",
            "type": "text"
          },
          {
            "ref": "price",
            "type": "money"
          },
          {
            "ref": "image_url",
            "type": "text",
            "semantic": "image"
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "[object Object]",
              "[object Object]",
              "[object Object]"
            ]
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "categories",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "slug",
            "type": "text"
          }
        ]
      },
      {
        "ref": "product_categories",
        "columns": [
          {
            "ref": "product_id",
            "type": "fk",
            "references": "products"
          },
          {
            "ref": "category_id",
            "type": "fk",
            "references": "categories"
          }
        ]
      },
      {
        "ref": "customers",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "email",
            "type": "text",
            "semantic": "email"
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "orders",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "number",
            "type": "text"
          },
          {
            "ref": "customer_id",
            "type": "fk",
            "references": "customers"
          },
          {
            "ref": "total",
            "type": "money"
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "[object Object]",
              "[object Object]",
              "[object Object]",
              "[object Object]"
            ]
          },
          {
            "ref": "placed_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "order_items",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "order_id",
            "type": "fk",
            "references": "orders"
          },
          {
            "ref": "product_id",
            "type": "fk",
            "references": "products"
          },
          {
            "ref": "qty",
            "type": "int"
          },
          {
            "ref": "unit_price",
            "type": "money"
          }
        ]
      }
    ]
  },
  "pages": [
    {
      "ref": "shop-dashboard",
      "template": "page-dashboard",
      "title": {
        "key": "mft.ecommerce.page.dashboard",
        "fallback": "Dashboard"
      },
      "nav": {
        "group": "manifest:ecommerce-shop",
        "icon": "layout-dashboard",
        "order": 1
      }
    },
    {
      "ref": "shop-products",
      "template": "page-crud",
      "title": {
        "key": "mft.ecommerce.page.products",
        "fallback": "Products"
      },
      "nav": {
        "group": "manifest:ecommerce-shop",
        "icon": "package",
        "order": 2
      }
    },
    {
      "ref": "shop-orders",
      "template": "page-queue-inbox",
      "title": {
        "key": "mft.ecommerce.page.orders",
        "fallback": "Orders"
      },
      "nav": {
        "group": "manifest:ecommerce-shop",
        "icon": "receipt",
        "order": 3
      }
    },
    {
      "ref": "shop-customers",
      "template": "page-directory",
      "title": {
        "key": "mft.ecommerce.page.customers",
        "fallback": "Customers"
      },
      "nav": {
        "group": "manifest:ecommerce-shop",
        "icon": "users",
        "order": 4
      }
    }
  ],
  "capabilities": [
    "payments",
    "file-storage",
    "email-delivery",
    "realtime"
  ],
  "kind": "app",
  "frontends": [
    {
      "side": "customer",
      "kind": "spa",
      "entry": "index.html",
      "env": {
        "VITE_ADMINIUM_API_BASE_URL": {
          "required": false,
          "example": "https://admin.example.com"
        },
        "VITE_ADMINIUM_PUBLISHABLE_KEY": {
          "required": false,
          "example": "adm_pub_..."
        }
      },
      "routes": {
        "storefront": "/"
      }
    }
  ]
}
